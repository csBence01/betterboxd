<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Betterboxd_IVTWAU.Views.MovieListPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Betterboxd_IVTWAU.ViewModels"
             xmlns:models="clr-namespace:Betterboxd_IVTWAU.Models"
             x:DataType="vm:MovieListViewModel"
             Title="Filmnapló">

    <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0"
                Text="+ Új film"
                Command="{Binding AddCommand}"
                Margin="10" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Movies}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Movie">
                    <Grid ColumnDefinitions="*,Auto" Padding="12,8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MovieListViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Year, StringFormat='({0})'}" FontSize="13" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="{Binding Rating, StringFormat='{0:0.0} ★'}"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>